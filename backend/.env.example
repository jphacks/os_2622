PORT=3001
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/pets.sqlite
# Must be 64 hex characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# LLM provider exposing OpenAI-compatible /chat/completions API
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
# Keep enabled for autonomous posting. Set false only if the compatible
# provider does not implement /moderations.
AI_MODERATION_ENABLED=true
AI_MODERATION_MODEL=omni-moderation-latest
# Optional: explicitly opt in to scheduler (also enable each pet)
ENABLE_SCHEDULER=false
