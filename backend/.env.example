PORT=3001
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/pets.sqlite
# Must be 64 hex characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Gemini API key: https://aistudio.google.com/apikey
# Keep this key on the backend; never expose it through VITE_* variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Gemini safety filters and local post validation are always enabled.
# Required for POST /api/bots/:did/posts. Generate a long random value and
# pass it only from the content-decision backend, never from the browser.
POST_RECEIVE_TOKEN=
# Optional: explicitly opt in to scheduler (also enable each pet)
ENABLE_SCHEDULER=false
